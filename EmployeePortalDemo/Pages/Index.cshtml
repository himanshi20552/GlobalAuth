@page
@model EmployeePortalDemo.Pages.Dashboard.IndexModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">

    <h2>Employee Dashboard</h2>
    <p class="text-muted">Welcome, @Model.Employee!.UserName</p>

    <hr />

    <h4>Employee Information</h4>

    <table class="table table-bordered">
        <tr>
            <th>Employee ID</th>
            <td>@Model.Employee.UserId</td>
        </tr>
        <tr>
            <th>Employee Name</th>
            <td>@Model.Employee.UserName</td>
        </tr>
    </table>

    <h4 class="mt-4">Assigned Groups</h4>

    @if (Model.Employee.Groups.Count > 0)
    {
        <ul>
            @foreach (var group in Model.Employee.Groups)
            {
                <li>@group</li>
            }
        </ul>
    }
    else
    {
        <p class="text-muted">No groups assigned.</p>
    }

    <h4 class="mt-4">Assigned Permissions</h4>

    @if (Model.Employee.Permissions.Count > 0)
    {
        <ul>
            @foreach (var permission in Model.Employee.Permissions)
            {
                <li>@permission</li>
            }
        </ul>
    }
    else
    {
        <p class="text-muted">No permissions assigned.</p>
    }

</div>
